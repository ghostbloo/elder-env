#!/bin/sh
# git credential helper: mints a <=1h installation token as elder-contrib[bot].
# git appends the operation (get/store/erase) as $1.
# Only Elder's Supabase login comes from sops; the GitHub App key is fetched
# from Secret Manager through workload identity federation (@familiar/gcp-wif).
# Absolute-ish PATH so this works from any caller's environment (git, launchd,
# a bare shell); bun is a user install since 2026-10-24.
PATH="$HOME/.bun/bin:/etc/profiles/per-user/$USER/bin:/run/current-system/sw/bin:/usr/bin:/bin"
export PATH
# Don't depend on the caller's shell for which age key sops uses.
SOPS_AGE_KEY_FILE="${SOPS_AGE_KEY_FILE:-$HOME/elder-cm/config/age/elder.key}"
export SOPS_AGE_KEY_FILE
exec sops exec-env /Users/me/familiar/who/elder/secrets/supabase.yaml \
  "bun /Users/me/familiar/who/elder/github/src/cli.ts git-credential $1"
